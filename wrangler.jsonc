// sayso.tahcin.tech: the built app (dist/) from the asset store, with worker/index.ts in front of /api/*.
// Build first: `npm run build`, then `npx wrangler deploy`. Wallet keys are secrets (`wrangler secret bulk`), never in this file.
{
  "name": "sayso",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "4627bf18a59329110c2a7a42c5562620",
  "assets": { "directory": "dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "routes": [{ "pattern": "sayso.tahcin.tech", "custom_domain": true }],
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
